<?php

declare(strict_types=1);

namespace App\{AppLayout}\{Domain}\Controllers;

use App\Http\Controllers\Controller;
use Illuminate\Contracts\View\View;
use Illuminate\Http\RedirectResponse;

use App\{Domain}\Queries\{Model}IndexQuery;
use App\{Domain}\ViewModels\{Model}IndexViewModel;
use App\{Domain}\ViewModels\{Model}ShowViewModel;

use App\{Domain}\Data\{Model}CreateData;
use App\{Domain}\Data\{Model}UpdateData;

use {RootNamespace}\Domain\{Domain}\Models\{Model};
// use {RootNamespace}\Domain\{Domain}\Orchestrators\{Orchestrator}; // preferred for complex flows
// use {RootNamespace}\Domain\{Domain}\Actions\{Action}; // ok for simple mutations

/**
 * Blade dashboard controller (multi-method example).
 *
 * Invokable SupplierHub/AdminHub endpoints use one class per route with
 * class-level #[Authorize(...)] on the controller — see controller.inertia.stub
 * and playbook docs/01-project-structure.md. This stub uses $this->authorize
 * per action when multiple methods share one class.
 */
final class {Model}Controller extends Controller
{
    public function __invoke({Model}IndexQuery $query): View
    {
        $this->authorize('view', {Model}::class);

        $items = $query
            ->paginate(request()->get('per_page', 50))
            ->withQueryString();

        $viewModel = new {Model}IndexViewModel(items: $items);

        return view('{blade_index_view}', $viewModel->toArray());
    }

    public function show({Model} $model): View
    {
        $this->authorize('view', {Model}::class);

        $viewModel = new {Model}ShowViewModel(model: $model);

        return view('{blade_show_view}', $viewModel->toArray());
    }

    // Typed Data parameters must use the full camelCase class short name.
    // Example: CustomerData $customerData, DraftLogData $draftLogData.
    public function store({Model}Data $modelData /*, {Orchestrator}|{Action} $handler */): RedirectResponse
    {
        $this->authorize('create', {Model}::class);

        // $handler(modelData: $modelData);

        return redirect()
            ->route('{index_route}')
            ->with('success', __('Created.'));
    }

    public function update({Model} $model, {Model}Data $modelData /*, {Orchestrator}|{Action} $handler */): RedirectResponse
    {
        $this->authorize('update', $model);

        // $handler(model: $model, modelData: $modelData);

        return redirect()
            ->back()
            ->with('success', __('Updated.'));
    }

    public function remove({Model} $model /*, {Orchestrator}|{Action} $handler */): RedirectResponse
    {
        $this->authorize('remove', $model);

        // $handler($model);

        return redirect()
            ->route('{index_route}')
            ->with('success', __('Removed.'));
    }

    /**
     * Export example:
     * - MUST use IndexQuery for data set
     */
    // public function export({Model}IndexQuery $query): \Symfony\Component\HttpFoundation\BinaryFileResponse
    // {
    //     $this->authorize('view', {Model}::class);
    //
    //     $timestamp = now()->format('Y-m-d-H-i-s');
    //
    //     return \Maatwebsite\Excel\Facades\Excel::download(
    //         new \App\{Domain}\Exports\{Model}Export($query),
    //         sprintf('{export_filename}-%s.xlsx', $timestamp)
    //     );
    // }
}
