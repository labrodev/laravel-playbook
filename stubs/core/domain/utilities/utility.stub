<?php

declare(strict_types=1);

namespace {{ RootNamespace }}\Domain\{{ Domain }}\Utilities;

// Utilities are small, atomic helpers used inside the Domain.
//
// They are NOT business logic, NOT workflows, and NOT state mutation.
//
// Purpose:
// - provide tiny, well-defined operations
// - calculate intermediate values
// - format or normalize data
// - group related constants to avoid hardcoding values across the codebase
//
// Typical use cases:
// - simple calculations derived from models or collections
// - normalization / transformation helpers
// - domain-scoped constant groups (keys, flags, identifiers)
//
// Utilities:
// - may contain static methods
// - may contain constants
// - must remain simple, deterministic, and side-effect free
//
// Utilities must NOT:
// - change persisted state
// - trigger Actions, Jobs, Events, or Services
// - implement business workflows or decisions
//
// Naming rules:
// - Class name must be self-descriptive but not over-engineered
// - Prefer expressing intent via method/constant names rather than long class names
//   (e.g. OrderProductQuantitizer::measure(), AttributeKey::PRICE_BATCH_LOG_ID)
//
// Domain placement rule:
// - Utilities are NOT attached to a specific model
// - If a utility lives inside a Domain, there must be a strong reason
//   it belongs to that Domain context and language
// - Do NOT use Domain utilities as generic helpers across unrelated domains
final class {{ UtilityClass }}
{
    // Example: constants grouped by meaning
    //
    // public const string SOME_DOMAIN_KEY = 'someDomainKey';

    // Example: tiny atomic helper method
    //
    // public static function calculate(...): int
    // {
    //     return ...;
    // }
}