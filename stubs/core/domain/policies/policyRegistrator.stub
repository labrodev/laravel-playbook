<?php

declare(strict_types=1);

namespace {{ RootNamespace }}\Domain\{{ Domain }}\Policies;

use {{ RootNamespace }}\Domain\{{ Domain }}\Models\{{ Model }};
use Illuminate\Support\Facades\Gate;

final class {{ Domain }}PolicyRegistrator
{
    // POLICY REGISTRATOR (PER DOMAIN)
    //
    // We keep a separate PolicyRegistrator per Domain to keep registration explicit
    // and avoid hidden policy wiring spread across the codebase.
    //
    // Rules:
    // - Policies are NOT registered inside Models
    // - Policies MUST be registered explicitly via Gate::policy(...)
    // - This class must be called from a ServiceProvider (usually AuthServiceProvider)
    //
    // This keeps:
    // - Models clean (persistence only)
    // - Authorization wiring explicit and centralized per Domain
    // - Boot order predictable in HTTP/CLI/Queue contexts

    public static function registerPolicies(): void
    {
        Gate::policy({{ Model }}::class, {{ Model }}Policy::class);

        // Register additional model policies for this domain here:
        // Gate::policy(OtherModel::class, OtherModelPolicy::class);
    }
}