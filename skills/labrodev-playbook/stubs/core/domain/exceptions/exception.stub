<?php

declare(strict_types=1);

namespace {{ RootNamespace }}\Domain\{{ Domain }}\Exceptions;

use Exception;

// Domain exceptions represent business-level failure conditions.
//
// They should be used to:
// - express invalid domain states
// - signal violated business rules
// - stop execution when the domain cannot proceed safely
//
// Domain exceptions must:
// - be descriptive and specific
// - represent business meaning (not technical errors)
// - avoid generic names (InvalidDataException, LogicException, etc.)
//
// Domain exceptions must NOT:
// - contain business logic
// - trigger workflows
// - call Actions, Services, Jobs, or external systems
// - depend on infrastructure concerns
final class {{ ExceptionClass }} extends Exception
{
    // Use named constructors to create exceptions explicitly
    // and keep exception creation consistent.
    public static function make(string $message): self
    {
        return new self($message);
    }
}