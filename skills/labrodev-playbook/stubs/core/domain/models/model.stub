<?php

declare(strict_types=1);

namespace Domain\{Domain}\Models;

use Domain\{Domain}\Collections\{Model}Collection;
use Domain\{Domain}\Factories\{Model}Factory;
use Domain\{Domain}\Observers\{Model}Observer;
use Domain\{Domain}\Policies\{Model}Policy;
use Core\Shared\Models\BaseModel;
use Illuminate\Database\Eloquent\Attributes\CollectedBy;
use Illuminate\Database\Eloquent\Attributes\ObservedBy;
use Illuminate\Database\Eloquent\Attributes\Table;
use Illuminate\Database\Eloquent\Attributes\UseFactory;
use Illuminate\Database\Eloquent\Attributes\UsePolicy;
use Illuminate\Database\Eloquent\Relations\BelongsTo;
use Illuminate\Database\Eloquent\Relations\HasMany;

// Recommended traits (enable if used in project)
// use Labrodev\Uuidable\Traits\ModelHasUuid;     // labrodev/laravel-uuidable
// use Labrodev\Numberable\Traits\ModelHasNumber; // labrodev/laravel-numberable

/**
 * IMPORTANT:
 * - Model is NEVER used for business logic, queries, scopes, or complex calculations.
 * - Keep models as clean as possible: state + casting + relations only.
 * - Models live in Domains (except User which is App\Models\User unless another alternative is defined).
 *
 * Laravel 13 — register table name, observer, collection, policy, and factory via class attributes (not methods).
 * Use #[Table('…')] when the DB table name is not Laravel’s default snake_plural of the class name.
 * Do NOT use protected $table. Do NOT call Model::observe() from boot() (causes recursive boot). Use #[ObservedBy] only.
 *
 * If the model has no factory yet, omit #[UseFactory(...)] and the {Model}Factory import.
 *
 * @property int $id
 * @property string|null $uuid
 * @property string|null $number
 *
 * @property \Illuminate\Support\Carbon|null $created_at
 * @property \Illuminate\Support\Carbon|null $updated_at
 * @property \Illuminate\Support\Carbon|null $deleted_at
 *
 * --- Attributes (accessors) ---
 * @property bool $isEditable
 * @property bool $isRemovable
 *
 * --- Relations ---
 * @property-read mixed $relations // document real relations here when you add them
 */
#[Table('{table}')]
#[ObservedBy({Model}Observer::class)]
#[CollectedBy({Model}Collection::class)]
#[UsePolicy({Model}Policy::class)]
#[UseFactory({Model}Factory::class)]
final class {Model} extends BaseModel
{
    // Highly recommended (enable when used):
    // use ModelHasUuid;
    // use ModelHasNumber;

    /**
     * Never use $fillable. Assignment happens outside the Model.
     */
    protected $visible = [
        'uuid',
        'number',
    ];

    /**
     * Object-state gates (isEditable, canBeDeleted) live in {Model}Rule.
     * Policies call {Model}Rule::… directly — do not add fetchRuleClass() on the model.
     *
     * Route URLs: do not override getRouteKeyName(). Bind by UUID in route definitions instead, e.g.
     * Route::get('{thing:uuid}', ...), Route::prefix('{thing:uuid}')->group(...).
     * See playbook/docs/05-database-and-models.md § Route parameters (UUID).
     */

    /**
     * Cast ONLY what exists in the concrete model.
     * Keep this minimal in the stub, add concrete keys later.
     */
    protected function casts(): array
    {
        return [
            // Examples (uncomment when relevant):
            // 'status' => \Domain\{Domain}\Enums\{Model}Status::class, // enums
            // 'source' => \Domain\{Domain}\Enums\{Model}Source::class, // enums
            // 'total' => 'float',                                     // float
            // 'items_count' => 'int',                                 // int
            // 'meta' => 'array',                                      // json -> array
            // 'paid_at' => 'datetime',                                // datetime
        ];
    }

    // -------------------------------------------------------------------------
    // Relations: declare ONLY real relations in concrete model.
    // Keep stub empty by default to avoid “always exists” feeling.
    // -------------------------------------------------------------------------

    // Example patterns (uncomment when needed):
    //
    // public function user(): BelongsTo
    // {
    //     return $this->belongsTo(\App\Models\User::class);
    // }
    //
    // public function items(): HasMany
    // {
    //     return $this->hasMany(\Domain\{Domain}\Models\{ChildModel}::class, '{model_snake}_id');
    // }
}
