<?php

declare(strict_types=1);

namespace {{ RootNamespace }}\Domain\{{ Domain }}\Policies;

use {{ RootNamespace }}\Base\Contracts\HasPermissions;
use {{ RootNamespace }}\Domain\{{ Domain }}\Models\{{ Model }};
use {{ RootNamespace }}\Domain\{{ Domain }}\Rules\{{ Model }}Rule;
use Illuminate\Contracts\Auth\Authenticatable;

final class {{ Model }}Policy
{
    // POLICIES
    //
    // Policies define authorization rules in business terms:
    // "Is this user allowed to perform THIS action on THIS object?"
    //
    // Policies MUST:
    // - remain explicit, readable, and predictable
    // - rely on permissions (RBAC) where applicable
    // - delegate object-state business gates to the Domain Rule class
    //
    // Policies MAY also include additional checks, for example:
    // - ownership checks (does the user belong to the object?)
    // - organisation/tenant scope checks
    // - marketplace / facility / team scope checks
    // - role constraints within a scope
    //
    // Policies MUST NOT:
    // - mutate state
    // - implement workflows
    // - call Actions, Orchestrators, Jobs
    // - duplicate business logic already expressed in Rules
    //
    // Domain Rule usage (canonical) — call the Rule class directly, not via the model:
    // {{ Model }}Rule::canBeDeleted($model);
    //
    // Permission constants:
    // - Permission names are DOMAIN + MODEL specific (not only domain-wide)
    // - The set of permissions is NOT fixed (not always view/create/update/remove)
    // - Define ONLY the permissions that exist and are required by this model/use-cases
    //
    // Examples:
    // - order.orders.view
    // - order.orders.update
    // - order.orders.analytics
    // - giftcard.giftcards.pay
    // - catalog.products.import

    // Define only what you actually use in this policy:
    public const string PERMISSION_VIEW = '{{ domain }}.{{ model }}.view';
    // public const string PERMISSION_CREATE = '{{ domain }}.{{ model }}.create';
    // public const string PERMISSION_UPDATE = '{{ domain }}.{{ model }}.update';
    // public const string PERMISSION_REMOVE = '{{ domain }}.{{ model }}.remove';
    // public const string PERMISSION_ANALYTICS = '{{ domain }}.{{ model }}.analytics';

    /**
     * @param Authenticatable&HasPermissions $user
     */
    public function view(Authenticatable $user): bool
    {
        return $user->hasPermissionTo(self::PERMISSION_VIEW);
    }

    /**
     * @param Authenticatable&HasPermissions $user
     */
    public function update(Authenticatable $user, {{ Model }} ${{ modelVariable }}): bool
    {
        return $user->hasPermissionTo(self::PERMISSION_VIEW)
            // Example contextual check (optional):
            // && $user->organisation_id === ${{ modelVariable }}->organisation_id
            && {{ Model }}Rule::isEditable(${{ modelVariable }});
    }

    /**
     * @param Authenticatable&HasPermissions $user
     */
    public function remove(Authenticatable $user, {{ Model }} ${{ modelVariable }}): bool
    {
        return $user->hasPermissionTo(self::PERMISSION_VIEW)
            && {{ Model }}Rule::canBeDeleted(${{ modelVariable }});
    }
}
