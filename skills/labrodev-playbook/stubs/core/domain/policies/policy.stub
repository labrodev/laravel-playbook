<?php

declare(strict_types=1);

namespace {{ RootNamespace }}\Domain\{{ Domain }}\Policies;

use {{ RootNamespace }}\Domain\{{ Domain }}\Models\{{ Model }};
use {{ RootNamespace }}\Domain\{{ Domain }}\Rules\{{ Model }}Rule;
use Illuminate\Contracts\Auth\Authenticatable;

final class {{ Model }}Policy
{
    // POLICIES
    //
    // Policies define authorization rules in business terms:
    // "Is this user allowed to perform THIS action on THIS object?"
    //
    // Wiring (Laravel 13):
    // - The policy is attached to its model via the class attribute:
    //   #[UsePolicy({{ Model }}Policy::class)] on the model class.
    // - Controllers authorize via the class-level attribute:
    //   #[Authorize({{ Model }}Policy::PERMISSION_VIEW, {{ Model }}::class)]     — list/create endpoints
    //   #[Authorize({{ Model }}Policy::PERMISSION_UPDATE, '{{ modelVariable }}')] — route-model-bound endpoints
    // - Do NOT register policies via Gate::policy() in a service provider.
    //
    // PERMISSION CONSTANT CONTRACT (critical):
    // - The constant VALUE must equal the policy METHOD name.
    //   PERMISSION_VIEW = 'view' resolves to view(), PERMISSION_UPDATE = 'update' to update().
    // - This is what makes #[Authorize(Policy::PERMISSION_X, ...)] resolve through Gate.
    //   A dotted value like 'order.orders.view' can NOT resolve to a policy method.
    // - Define ONLY the permissions that exist for this model's use cases;
    //   the set is not fixed (not always view/create/update/remove).
    //
    // Policies MUST:
    // - remain explicit, readable, and predictable
    // - layer checks in order: non-null user → ownership/scope → Domain Rule
    // - delegate object-state business gates to the Domain Rule class
    //
    // Policies MAY also include additional checks, for example:
    // - ownership checks (does the user belong to the object?)
    // - ownership/scope checks (adjust to the project's ownership model)
    // - role or RBAC permission constraints (e.g. spatie/laravel-permission):
    //   $user->hasPermissionTo('{{ domain }}.{{ model }}.view')
    //   (RBAC permission keys are dotted strings — they live INSIDE method bodies,
    //   never as the constant value.)
    //
    // Policies MUST NOT:
    // - mutate state
    // - implement workflows
    // - call Actions, Orchestrators, Jobs
    // - duplicate business logic already expressed in Rules
    //
    // Domain Rule usage (canonical) — call the Rule class directly, not via the model:
    // {{ Model }}Rule::canBeDeleted(${{ modelVariable }});

    public const string PERMISSION_VIEW = 'view';

    public const string PERMISSION_CREATE = 'create';

    public const string PERMISSION_UPDATE = 'update';

    public const string PERMISSION_REMOVE = 'remove';

    public function view(?Authenticatable $user): bool
    {
        return $user !== null;
        // With RBAC: return $user !== null && $user->hasPermissionTo('{{ domain }}.{{ model }}.view');
    }

    public function create(?Authenticatable $user): bool
    {
        return $user !== null;
    }

    public function update(?Authenticatable $user, {{ Model }} ${{ modelVariable }}): bool
    {
        return $user !== null
            // Ownership / scope check (adjust to the project's ownership model):
            // && $user->organisation_id === ${{ modelVariable }}->organisation_id
            && {{ Model }}Rule::isEditable(${{ modelVariable }});
    }

    public function remove(?Authenticatable $user, {{ Model }} ${{ modelVariable }}): bool
    {
        return $user !== null
            && {{ Model }}Rule::canBeDeleted(${{ modelVariable }});
    }
}
