<?php

declare(strict_types=1);

namespace {{ RootNamespace }}\Domain\{{ Domain }}\Casts;

use {{ RootNamespace }}\Domain\{{ Domain }}\Collections\{{ CollectionClass }};
use {{ RootNamespace }}\Domain\{{ Domain }}\Models\{{ Model }};
use {{ RootNamespace }}\Domain\{{ Domain }}\Queries\{{ Model }}Query;
use Spatie\LaravelData\Casts\Cast;
use Spatie\LaravelData\Contracts\BaseData;
use Spatie\LaravelData\Support\Creation\CreationContext;
use Spatie\LaravelData\Support\DataProperty;

final readonly class {{ Model }}CollectionCaster implements Cast
{
    // COLLECTION CASTER
    //
    // Naming rules:
    // - Class name MUST start with the Model name
    // - Must end with "CollectionCaster"
    //
    // Examples:
    // - MarketplaceCollectionCaster
    // - ProductCollectionCaster
    //
    // Purpose:
    // - convert raw input (array of scalar identifiers) into a typed Domain collection
    // - keep all collection-resolving logic in one place
    //
    // Data contract rules:
    // - Data property name = validation key = caster input
    // - Raw input is an array of scalars (uuid strings)
    // - Validation must be defined in Data::rules() for the SAME key
    //   (e.g. 'products' => ['required', 'array'], 'products.*' => ['string', 'exists:products,uuid'])
    //
    // Resolution rules:
    // - Models MUST be resolved via the Domain Query class
    // - Never resolve models directly via Eloquent here
    //
    // Behavior rules:
    // - If the value is already a typed collection, pass it through unchanged.
    //   This allows constructing Data directly in code and tests.
    // - Missing identifiers simply resolve to a smaller collection — reject them
    //   via the validation rules on the SAME key, never by throwing here.

    /**
     * @param  array<string, mixed>  $properties
     * @param  CreationContext<BaseData<mixed, mixed, array-key>>  $context
     */
    public function cast(
        DataProperty $property,
        mixed $value,
        array $properties,
        CreationContext $context
    ): {{ CollectionClass }} {
        if ($value instanceof {{ CollectionClass }}) {
            return $value;
        }

        $uuids = collect((array) $value)
            ->filter(fn (mixed $item): bool => is_string($item) && $item !== '')
            ->values();

        if ($uuids->isEmpty()) {
            return new {{ CollectionClass }}();
        }

        return resolve({{ Model }}Query::class)
            ->byUuids($uuids->all())
            ->get();
    }
}
