<?php

declare(strict_types=1);

namespace {{ RootNamespace }}\Domain\{{ Domain }}\Casts;

use {{ RootNamespace }}\Domain\{{ Domain }}\Models\{{ Model }};
use {{ RootNamespace }}\Domain\{{ Domain }}\Queries\{{ Model }}Query;
use Spatie\LaravelData\Casts\Cast;
use Spatie\LaravelData\Casts\Uncastable;
use Spatie\LaravelData\Contracts\BaseData;
use Spatie\LaravelData\Support\Creation\CreationContext;
use Spatie\LaravelData\Support\DataProperty;

final readonly class {{ Model }}UuidCaster implements Cast
{
    // OBJECT (UUID) CASTER
    //
    // Naming rules:
    // - Class name MUST start with the Model name
    // - Must end with "UuidCaster" (or "IdCaster" when resolving by another identifier)
    //
    // Examples:
    // - ProjectUuidCaster
    // - CategoryUuidCaster
    //
    // Purpose:
    // - convert a raw scalar identifier (uuid string) into the resolved Domain model
    // - keep all model-resolving logic in one place
    //
    // Data contract rules:
    // - Data property name = validation key = caster input
    // - Raw input is a single scalar identifier (uuid string)
    // - Validation must be defined in Data::rules() for the SAME key
    //   (e.g. 'project' => ['required', 'string', 'exists:projects,uuid'])
    //
    // Resolution rules:
    // - Models MUST be resolved via the Domain Query class
    // - Never resolve models directly via Eloquent here
    //
    // Behavior rules:
    // - If the value is already a model instance, pass it through unchanged.
    //   This allows constructing Data directly in code and tests:
    //   {{ DataClass }}::from(['{{ related_entity }}' => ${{ modelVariable }}])
    // - Return Uncastable::create() for missing or invalid values — never throw here.
    //   The validation rule on the SAME key is responsible for rejecting bad input
    //   with a proper message.

    /**
     * @param  array<string, mixed>  $properties
     * @param  CreationContext<BaseData<mixed, mixed, array-key>>  $context
     */
    public function cast(
        DataProperty $property,
        mixed $value,
        array $properties,
        CreationContext $context
    ): {{ Model }}|Uncastable {
        if ($value instanceof {{ Model }}) {
            return $value;
        }

        if (! is_string($value) || $value === '') {
            return Uncastable::create();
        }

        return resolve({{ Model }}Query::class)
            ->byUuid($value)
            ->first() ?? Uncastable::create();
    }
}
