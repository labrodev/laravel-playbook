namespace {{ RootNamespace }}\Domain\{{ Domain }}\Events;

use Illuminate\Foundation\Events\Dispatchable;
use Illuminate\Queue\SerializesModels;

// Domain Events represent facts that have already happened in the domain.
//
// They are descriptive, not imperative.
// Example: PaymentSuccessful (NOT ProcessPayment)
//
// Purpose:
// - signal that something significant occurred
// - allow asynchronous or decoupled reactions
// - avoid direct coupling between domain operations
//
// Domain Events may be dispatched:
// - explicitly via event(new Event(...))
// - implicitly as part of Laravel listeners or observers
//
// Events must NOT:
// - contain business logic
// - mutate state
// - trigger workflows directly
// - call Actions, Services, or Jobs
//
// Events carry data only.
// All behavior in response to an event must live in:
// - Listeners
// - Jobs (usually queued)
// - other asynchronous handlers
final readonly class {{ EventClass }}
{
    use Dispatchable, SerializesModels;

    public function __construct(
        // Event payload:
        // - must be immutable
        // - must represent domain data that already exists
        // - typically a Model or value object
        public {{ PayloadType }} ${{ payloadVariable }}
    ) {}
}