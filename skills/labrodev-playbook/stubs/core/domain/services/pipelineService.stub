<?php

declare(strict_types=1);

namespace {{ RootNamespace }}\Domain\{{ Domain }}\Services;

use {{ RootNamespace }}\Domain\{{ Domain }}\Payloads\{{ Workflow }}Payload;
use {{ RootNamespace }}\Domain\{{ Domain }}\Pipelines\{{ Workflow }}\{{ FirstStep }};
use {{ RootNamespace }}\Domain\{{ Domain }}\Pipelines\{{ Workflow }}\{{ SecondStep }};
use {{ RootNamespace }}\Shared\Exceptions\Pipelines\PipelinePayloadIncorrect;
use Illuminate\Pipeline\Pipeline;

// PIPELINE-ORCHESTRATING SERVICE
//
// A Service plays the orchestrator role for staged workflows — there is no
// separate Orchestrator class type. Use when a use case is several distinct
// side-effecting steps (create + mail + log + external system), not one
// atomic mutation.
//
// - Lives in {Domain}/Services (or Core/Feature/{FeatureName}/Services when
//   the workflow spans domains).
// - Single public __invoke(); callers inject it and invoke it as a callable
//   with named arguments, exactly like an Action.
// - Steps live in Pipelines/{{ Workflow }}/ and are verb-first classes with
//   no suffix; the Payload carries flow state.
// - Mutating steps delegate to Actions (each with its own transaction);
//   order persistence steps before mail/CRM/external steps. Never wrap the
//   whole pipeline in one DB::transaction.
//
// NOTE: PipelinePayloadIncorrect is a Shared exception. Create it alongside
// the project's first pipeline using the named-constructor pattern from
// stubs/core/domain/exceptions/exception.stub.

final readonly class {{ Workflow }}Service
{
    public function __construct(
        // Inject queries/rules needed for pre-checks only
    ) {}

    /**
     * @throws PipelinePayloadIncorrect
     */
    public function __invoke({{ InputType }} ${{ inputVariable }}): {{ ReturnType }}
    {
        // Optional guard clauses here (delegate conditions to Rule classes).

        $payload = {{ Workflow }}Payload::make(
            {{ inputVariable }}: ${{ inputVariable }},
        );

        $resultPayload = app(Pipeline::class)
            ->send($payload)
            ->through([
                {{ FirstStep }}::class,
                {{ SecondStep }}::class,
                // ...
            ])
            ->thenReturn();

        if (! $resultPayload instanceof {{ Workflow }}Payload) {
            throw PipelinePayloadIncorrect::make({{ Workflow }}Payload::class);
        }

        return $resultPayload->{{ resultProperty }};
    }
}
