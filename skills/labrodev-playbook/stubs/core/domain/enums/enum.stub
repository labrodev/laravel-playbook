<?php

declare(strict_types=1);

namespace {{ RootNamespace }}\Domain\{{ Domain }}\Enums;

// Enums represent constrained domain values.
//
// They must be used for:
// - statuses
// - types
// - modes
// - any field with a finite allowed set and matching logic
//
// NAMING RULE:
// If an enum corresponds to a specific model, its name MUST start with the model name.
// Examples:
// - CategoryStatus
// - ProductType
// - OrderState
//
// Avoid generic enum names like Status, Type, State.
//
// The backing type MUST be scalar (enum language constraint):
// - int
// - string
//
// The choice of backing type depends on domain logic and persistence needs.
// Enums are about meaning and constraints, not storage convenience.
enum {{ EnumClass }}: {{ BackingType }}
{
    case {{ CaseOne }} = {{ CaseOneValue }};
    case {{ CaseTwo }} = {{ CaseTwoValue }};

    // Enum helper methods are OPTIONAL.
    //
    // The presentation helper is ALWAYS named label() — EnumMapper and Resources
    // rely on this name ('status_label' => $model->status->label()).
    // Additional helpers like color(), icon(), shortLabel() may be added
    // to centralize matching / presentation logic.
    //
    // These methods:
    // - must be pure
    // - must not trigger side effects
    // - must not call Actions, Services, Jobs, or external APIs
    // - must not contain business workflows
    //
    // Example helper method (optional):
    public function label(): string
    {
        return match ($this) {
            self::{{ CaseOne }} => trans('{{ CaseOneLabel }}'),
            self::{{ CaseTwo }} => trans('{{ CaseTwoLabel }}'),
        };
    }

    // Static domain lookups are allowed as named constructors wrapping tryFrom():
    //
    // public static function fromSeconds(int $seconds): ?self
    // {
    //     return self::tryFrom($seconds);
    // }

    // FULL ENUM CONTRACT (when the enum crosses a boundary):
    // - Data class: typed enum property + Rule::enum({{ EnumClass }}::class)
    //   (see docs/04 § Enums in Data classes)
    // - Model: cast in casts() when the enum backs a model field (below)
    // - Resources: emit value + label pairs ('status' => ->value, 'status_label' => ->label())
    // - Select/filter options: EnumMapper::keyValues({{ EnumClass }}::cases(), 'label')
    //   in ViewModels (labrodev/php-enum-mapper)

    // IMPORTANT:
    // If a model field corresponds to this enum, it MUST be cast in the model
    // via the casts() METHOD (never the $casts property):
    //
    // protected function casts(): array
    // {
    //     return [
    //         '{{ field_name }}' => {{ EnumClass }}::class,
    //     ];
    // }
}