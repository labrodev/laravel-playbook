<?php

declare(strict_types=1);

namespace Domain\{Domain}\Orchestrators;

use Illuminate\Pipeline\Pipeline;
use Domain\{Domain}\Payloads\{Payload};
use Domain\{Domain}\Pipelines\{Orchestrator}\{FirstPipeline};
use Domain\{Domain}\Pipelines\{Orchestrator}\{SecondPipeline};
use Core\Shared\Exceptions\Pipelines\PipelinePayloadIncorrect;

final readonly class {Orchestrator}
{
    public function __construct(
        // Inject queries/actions/services needed for pre-checks only
        // private {SomethingQuery} $somethingQuery,
    ) {}

    /**
     * Orchestrators:
     * - trigger pipelines with a payload
     * - represent a complete business use case (complex logic)
     * - validate the result type and return final object/result
     *
     * @throws PipelinePayloadIncorrect
     * @throws \Throwable // replace with concrete domain exceptions
     */
    public function execute({InputType} $input): {ReturnType}
    {
        // Optional pre-checks / guard clauses here (context-driven)
        // e.g. check if already processed, validate state, etc.

        $payload = {Payload}::make(
            // input: $input,
        );

        $resultPayload = app(Pipeline::class)
            ->send($payload)
            ->through([
                {FirstPipeline}::class,
                {SecondPipeline}::class,
                // ...
            ])
            ->thenReturn();

        if (! $resultPayload instanceof {Payload}) {
            throw PipelinePayloadIncorrect::make({Payload}::class);
        }

        // Return final result from payload (object / DTO / scalar), or throw domain exception
        return $resultPayload->{resultProperty};
    }
}