<?php

declare(strict_types=1);

namespace {{ RootNamespace }}\Domain\{{ Domain }}\Queries;

use {{ RootNamespace }}\Domain\{{ Domain }}\Models\{{ Model }};
use Illuminate\Database\Eloquent\Builder;

final class {{ Model }}Query
{
    // One Query class per Model.
    //
    // This class is the single source of truth for querying {{ Model }}.
    //
    // Purpose:
    // - avoid scattered query variations across the codebase
    // - keep read-side filtering/sorting/joining consistent
    // - centralize query intent aligned with business needs
    //
    // Rules:
    // - always use {{ Model }}::query() as the entry point
    // - methods should return Builder<{{ Model }}> (enforced via PHPDoc) unless documented exception
    // - add new methods only when required by business logic
    //
    // Narrow exception — terminal reads only:
    // A method may return bool/int/etc. when the method name states the intent (e.g. existsForCustomer(): bool)
    // and the implementation is a thin terminal on the builder (exists/count/value). Do not return
    // resolved collections or arbitrary arrays from methods that look like query builders (e.g. all()).
    //
    // Default baseline methods are:
    // - all()
    // - byId()
    // - byUuid()
    // - byUuids()

    /**
     * @return Builder<{{ Model }}>
     */
    public function all(): Builder
    {
        return {{ Model }}::query();
    }

    /**
     * @return Builder<{{ Model }}>
     */
    public function byId(int $id): Builder
    {
        return {{ Model }}::query()->where('id', '=', $id);
    }

    /**
     * @return Builder<{{ Model }}>
     */
    public function byUuid(string $uuid): Builder
    {
        return {{ Model }}::query()->where('uuid', '=', $uuid);
    }

    /**
     * @param  array<int, string>  $uuids
     * @return Builder<{{ Model }}>
     */
    public function byUuids(array $uuids): Builder
    {
        return {{ Model }}::query()->whereIn('uuid', $uuids);
    }

    // Add additional query methods only when demanded by business logic.
    //
    // Examples:
    // - active()
    // - atWarehouse(...)
    // - search(...)
    //
    // Query methods must NOT:
    // - mutate state
    // - call Actions or Services
    // - perform writes or side effects
}