<?php

declare(strict_types=1);

namespace App\Layer\{{ Layer }}\{{ Domain }}\Controllers;

use App\Http\Controllers\Controller;
use App\Layer\{{ Layer }}\{{ Domain }}\IndexQueries\{{ Model }}IndexQuery;
use App\Layer\{{ Layer }}\{{ Domain }}\ViewModels\{{ Model }}IndexViewModel;
use {{ RootNamespace }}\Domain\{{ Domain }}\Models\{{ Model }};
use {{ RootNamespace }}\Domain\{{ Domain }}\Policies\{{ Model }}Policy;
use Illuminate\Routing\Attributes\Controllers\Authorize;
use Inertia\Inertia;
use Inertia\Response;

/**
 * Single-responsibility, invokable Inertia READ controller (index page).
 *
 * One HTTP endpoint → one invokable controller.
 * Naming: Model + Action + Controller (BookingIndexController, BookingShowController).
 * Controllers remain thin: I/O + delegation to Core (Actions/Orchestrators).
 *
 * Authorization: class-level #[Authorize(...)] — ability constant + Model::class for
 * list/create endpoints, ability constant + route-parameter name string for
 * route-model-bound endpoints; see playbook docs/01-project-structure.md.
 *
 * For the WRITE counterpart (store/update), see controller.inertia.write.stub.
 */
#[Authorize({{ Model }}Policy::PERMISSION_VIEW, {{ Model }}::class)]
final class {{ Model }}IndexController extends Controller
{
    public function __invoke({{ Model }}IndexQuery ${{ modelVariable }}IndexQuery): Response
    {
        $items = ${{ modelVariable }}IndexQuery
            ->paginate(request()->integer('per_page', 50))
            ->withQueryString();

        $viewModel = new {{ Model }}IndexViewModel(items: $items);

        return Inertia::render('{{ inertia_index_view }}', $viewModel->toArray());
    }
}
