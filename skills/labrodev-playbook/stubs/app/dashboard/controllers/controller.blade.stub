<?php

declare(strict_types=1);

namespace App\Layer\{{ Layer }}\{{ Domain }}\Controllers;

use App\Http\Controllers\Controller;
use Illuminate\Contracts\View\View;
use Illuminate\Http\RedirectResponse;
use Illuminate\Support\Facades\Gate;

use App\Layer\{{ Layer }}\{{ Domain }}\IndexQueries\{{ Model }}IndexQuery;
use App\Layer\{{ Layer }}\{{ Domain }}\ViewModels\{{ Model }}IndexViewModel;
use App\Layer\{{ Layer }}\{{ Domain }}\ViewModels\{{ Model }}ShowViewModel;

use {{ RootNamespace }}\Domain\{{ Domain }}\Data\{{ Model }}CreateData;
use {{ RootNamespace }}\Domain\{{ Domain }}\Data\{{ Model }}UpdateData;

use {{ RootNamespace }}\Domain\{{ Domain }}\Models\{{ Model }};
// use {{ RootNamespace }}\Domain\{{ Domain }}\Orchestrators\{{ Orchestrator }}; // preferred for complex flows
// use {{ RootNamespace }}\Domain\{{ Domain }}\Actions\{{ Action }}; // ok for simple mutations

/**
 * Blade dashboard controller (multi-method LEGACY exception).
 *
 * Inertia/Dashboard/API endpoints use one invokable class per route with
 * class-level #[Authorize(...)] on the controller — see controller.inertia.stub
 * and playbook docs/01-project-structure.md. This stub uses Gate::authorize
 * per action ONLY because multiple methods share one class (Blade surfaces);
 * the Laravel 13 base Controller has no authorize() helper.
 */
final class {{ Model }}Controller extends Controller
{
    public function __invoke({{ Model }}IndexQuery ${{ modelVariable }}IndexQuery): View
    {
        Gate::authorize('view', {{ Model }}::class);

        $items = ${{ modelVariable }}IndexQuery
            ->paginate(request()->integer('per_page', 50))
            ->withQueryString();

        $viewModel = new {{ Model }}IndexViewModel(items: $items);

        return view('{{ blade_index_view }}', $viewModel->toArray());
    }

    public function show({{ Model }} ${{ modelVariable }}): View
    {
        Gate::authorize('view', {{ Model }}::class);

        $viewModel = new {{ Model }}ShowViewModel({{ modelVariable }}: ${{ modelVariable }});

        return view('{{ blade_show_view }}', $viewModel->toArray());
    }

    // Typed Data parameters must mirror the full class short name in camelCase.
    // Example: BookingCreateData $bookingCreateData — never $data or $modelData.
    public function store({{ Model }}CreateData ${{ modelVariable }}CreateData /*, {{ Model }}Create ${{ modelVariable }}Create */): RedirectResponse
    {
        Gate::authorize('create', {{ Model }}::class);

        // Invoke the Action as a callable with NAMED arguments:
        // ${{ modelVariable }}Create({{ modelVariable }}CreateData: ${{ modelVariable }}CreateData);

        return redirect()
            ->route('{{ index_route }}')
            ->with('success', __('Created.'));
    }

    public function update({{ Model }} ${{ modelVariable }}, {{ Model }}UpdateData ${{ modelVariable }}UpdateData /*, {{ Model }}Update ${{ modelVariable }}Update */): RedirectResponse
    {
        Gate::authorize('update', ${{ modelVariable }});

        // ${{ modelVariable }}Update({{ modelVariable }}: ${{ modelVariable }}, {{ modelVariable }}UpdateData: ${{ modelVariable }}UpdateData);

        return redirect()
            ->back()
            ->with('success', __('Updated.'));
    }

    public function remove({{ Model }} ${{ modelVariable }} /*, {{ Model }}Remove ${{ modelVariable }}Remove */): RedirectResponse
    {
        Gate::authorize('remove', ${{ modelVariable }});

        // ${{ modelVariable }}Remove({{ modelVariable }}: ${{ modelVariable }});

        return redirect()
            ->route('{{ index_route }}')
            ->with('success', __('Removed.'));
    }

    /**
     * Export example:
     * - MUST use IndexQuery for data set
     */
    // public function export({{ Model }}IndexQuery ${{ modelVariable }}IndexQuery): \Symfony\Component\HttpFoundation\BinaryFileResponse
    // {
    //     Gate::authorize('view', {{ Model }}::class);
    //
    //     $timestamp = now()->format('Y-m-d-H-i-s');
    //
    //     return \Maatwebsite\Excel\Facades\Excel::download(
    //         new \App\Layer\{{ Layer }}\{{ Domain }}\Exports\{{ Model }}Export(${{ modelVariable }}IndexQuery),
    //         sprintf('{{ export_filename }}-%s.xlsx', $timestamp)
    //     );
    // }
}
