<?php

declare(strict_types=1);

namespace App\Layer\{{ Layer }}\{{ Domain }}\Controllers;

use App\Http\Controllers\Controller;
use {{ RootNamespace }}\Domain\{{ Domain }}\Actions\{{ Model }}Create;
use {{ RootNamespace }}\Domain\{{ Domain }}\Data\{{ Model }}Data;
use {{ RootNamespace }}\Domain\{{ Domain }}\Models\{{ Model }};
use {{ RootNamespace }}\Domain\{{ Domain }}\Policies\{{ Model }}Policy;
use Illuminate\Http\RedirectResponse;
use Illuminate\Routing\Attributes\Controllers\Authorize;
use Inertia\Inertia;

/**
 * Single-responsibility, invokable Inertia WRITE controller (store example).
 *
 * Naming: Model + Action + Controller (BookingStoreController, BookingUpdateController).
 *
 * Write-side flow: Layer Controller → Spatie Data → Core Action → Model.
 * - The Data class is injected as an __invoke() parameter (validation happens on resolve).
 * - The Action is injected as an __invoke() parameter and invoked as a CALLABLE
 *   with NAMED arguments — never ->execute()/->handle().
 * - Typed Data parameters mirror the class short name in camelCase:
 *   {{ Model }}Data ${{ modelVariable }}Data — never $data.
 * - ONE shared {{ Model }}Data serves both store and update by default; split
 *   into {{ Model }}CreateData / {{ Model }}UpdateData ONLY when the two
 *   operations accept different fields.
 * - No business logic here: no validate(), no branching, no calculations.
 *
 * Response idiom:
 * - Flash a toast: Inertia::flash('toast', ['type' => 'success|error|info', 'message' => trans(...)])
 * - Redirect with the to_route() helper — never redirect()->route().
 *
 * For UPDATE endpoints: add the route-model-bound {{ Model }} parameter, switch to
 * #[Authorize({{ Model }}Policy::PERMISSION_UPDATE, '{{ modelVariable }}')], and invoke
 * ${{ modelVariable }}Update({{ modelVariable }}: ${{ modelVariable }}, {{ modelVariable }}Data: ${{ modelVariable }}Data).
 */
#[Authorize({{ Model }}Policy::PERMISSION_CREATE, {{ Model }}::class)]
final class {{ Model }}StoreController extends Controller
{
    public function __invoke(
        {{ Model }}Data ${{ modelVariable }}Data,
        {{ Model }}Create ${{ modelVariable }}Create,
    ): RedirectResponse {
        ${{ modelVariable }}Create(
            {{ modelVariable }}Data: ${{ modelVariable }}Data,
        );

        Inertia::flash('toast', ['type' => 'success', 'message' => trans('{{ Model }} created.')]);

        return to_route('{{ index_route }}');
    }
}
