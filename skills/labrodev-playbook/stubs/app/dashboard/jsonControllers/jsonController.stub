<?php

declare(strict_types=1);

namespace App\Layer\{{ Layer }}\{{ Domain }}\JsonControllers;

use App\Http\Controllers\Controller;
use {{ RootNamespace }}\Domain\{{ Domain }}\Models\{{ Model }};
use {{ RootNamespace }}\Domain\{{ Domain }}\Policies\{{ Model }}Policy;
use {{ RootNamespace }}\Domain\{{ Domain }}\Resources\{{ Model }}Resource;
// use {{ RootNamespace }}\Domain\{{ Domain }}\Services\{{ Service }};
// use {{ RootNamespace }}\Domain\{{ Domain }}\Data\{{ DataClass }};
use Illuminate\Http\Resources\Json\AnonymousResourceCollection;
use Illuminate\Routing\Attributes\Controllers\Authorize;

/**
 * JSON API controller for in-page interactions.
 *
 * Returns JSON responses (not Inertia views) for wizard steps,
 * autocomplete, search, or dynamic calculations within an Inertia page.
 *
 * Same rules as regular controllers:
 * - Invokable, single-responsibility, thin
 * - Delegates to Core Actions/Services
 * - Class-level #[Authorize(...)] — adjust ability / arguments per endpoint
 * - Write-side uses typed Data objects, never Request
 * - Typed Data parameters must mirror the class short name in camelCase
 *   (example: DraftLogData $draftLogData, CustomerData $customerData)
 * - Returns JsonResource or AnonymousResourceCollection
 *
 * Route: nested under `json/` prefix in the resource route group.
 * Frontend: called via `@/lib/http` (jsonPost/jsonGet), not Inertia.
 */
#[Authorize({{ Model }}Policy::PERMISSION_VIEW, {{ Model }}::class)]
final class {{ Model }}{{ Verb }}Controller extends Controller
{
    public function __invoke(/* {{ Service }} ${{ serviceVariable }} */): AnonymousResourceCollection
    {
        // Delegate to a Core Service or Action invoked as a
        // callable with NAMED arguments:
        // $results = ${{ serviceVariable }}(term: request()->string('term')->toString());

        return {{ Model }}Resource::collection($results);
    }
}
