<?php

declare(strict_types=1);

namespace App\Layer\{{ Layer }}\{{ Domain }}\ViewModels;

use Illuminate\Pagination\LengthAwarePaginator;
use Spatie\ViewModels\ViewModel;
use {{ RootNamespace }}\Domain\{{ Domain }}\Resources\{{ Model }}{{ Context }}Resource;
// use Labrodev\PhpEnumMapper\EnumMapper; // when shipping enum select/filter options

final class {{ Model }}IndexViewModel extends ViewModel
{
    /**
     * ViewModel responsibilities:
     * - Collect and shape all data needed by the Inertia page.
     * - Provide business/data payloads only (no UI translation payloads).
     * - No business logic; only presentation shaping and mapping.
     *
     * Base class: extend Spatie\ViewModels\ViewModel directly and ALWAYS
     * override toArray() — the controller passes $viewModel->toArray() to
     * Inertia::render(); Spatie's magic view-data features are not used.
     *
     * Resources are ALWAYS materialized with ->resolve() inside the ViewModel —
     * never returned as JsonResource instances to Inertia.
     *
     * SECURITY: All props are serialized into the DOM (data-page attribute).
     * Never pass raw models — always use Resources to expose only needed fields.
     * Review output for sensitive data: passwords, tokens, internal IDs, system flags.
     */
    public function __construct(
        private readonly LengthAwarePaginator $items,
    ) {}

    /**
     * @return array<string, mixed>
     */
    public function toArray(): array
    {
        $resourceCollection = {{ Model }}{{ Context }}Resource::collection(
            $this->items->getCollection()
        )->resolve();

        return [
            '{{ itemsKey }}' => [
                'data' => $resourceCollection,
                'current_page' => $this->items->currentPage(),
                'last_page' => $this->items->lastPage(),
                'per_page' => $this->items->perPage(),
                'total' => $this->items->total(),
                'from' => $this->items->firstItem(),
                'to' => $this->items->lastItem(),
                'links' => $this->items->linkCollection()->toArray(),
            ],

            // Optional: extra config/options for filters, statuses, enums etc.
            // Enum select/filter options are built with EnumMapper (labrodev/php-enum-mapper):
            // 'status_options' => EnumMapper::keyValues({{ EnumClass }}::cases(), 'label'),
        ];
    }
}
