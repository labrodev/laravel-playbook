<?php

declare(strict_types=1);

namespace App\{AppLayout}\{Domain}\ViewModels;

use App\{UiNamespace}\ViewModels\ViewModel;
use {RootNamespace}\Domain\{Domain}\Models\{Model};
use {RootNamespace}\Domain\{Domain}\Resources\{Model}{Context}Resource;

final class {Model}ShowViewModel extends ViewModel
{
    /**
     * ViewModel responsibilities:
     * - Collect and shape all data needed by the Inertia page (often form page).
     * - Load required relations for rendering.
     * - Provide business/data payloads only (no UI translation payloads).
     * - No business logic; only presentation shaping and mapping.
     *
     * SECURITY: All props are serialized into the DOM (data-page attribute).
     * Never pass raw models — always use Resources to expose only needed fields.
     * Review output for sensitive data: passwords, tokens, internal IDs, system flags.
     */
    public function __construct(
        private readonly {Model} $model,
    ) {}

    /**
     * @return array<string, mixed>
     */
    public function toArray(): array
    {
        $this->model->load([
            // 'relationA',
            // 'relationB.nested',
        ]);

        return [
            '{modelKey}' => (new {Model}{Context}Resource($this->model))->resolve(),

            // Optional: any extra form data (select options, permissions, statuses, etc.)
            // 'options' => $this->getOptions(),
        ];
    }

    /**
     * Optional helper for form select options.
     *
     * @return array<string, mixed>
     */
    // private function getOptions(): array
    // {
    //     return [
    //         // 'statuses' => [...],
    //     ];
    // }
}
